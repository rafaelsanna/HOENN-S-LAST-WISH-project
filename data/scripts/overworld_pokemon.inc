@ Basic interactions for overworld Pokémon that only need to face the player and cry.

EventScript_OverworldPokemonCry_AZUMARILL::
	lock
	faceplayer
	playmoncry SPECIES_AZUMARILL, CRY_MODE_NORMAL
	waitmoncry
	release
	end

