raw `
PHOENIXPOKEMART_MapScripts::
	.byte 0

PHOENIXPOKEMART_EventScript_Clerk::
	lock
	faceplayer
	message gText_HowMayIServeYou
	waitmessage
	pokemart PHOENIXPOKEMART_Pokemart
	msgbox gText_PleaseComeAgain, MSGBOX_DEFAULT
	release
	end

	.align 2
PHOENIXPOKEMART_Pokemart:
	.2byte ITEM_GREAT_BALL
	.2byte ITEM_SUPER_POTION
	.2byte ITEM_ANTIDOTE
	.2byte ITEM_PARALYZE_HEAL
	.2byte ITEM_AWAKENING
	.2byte ITEM_ESCAPE_ROPE
	.2byte ITEM_SUPER_REPEL
	.2byte ITEM_X_ATTACK
	.2byte ITEM_X_DEFENSE
	.2byte ITEM_DIRE_HIT
	.2byte ITEM_GUARD_SPEC
	pokemartlistend

PHOENIXPOKEMART_EventScript_Lass::
	msgbox PHOENIXPOKEMART_Text_Supplies, MSGBOX_NPC
	end

PHOENIXPOKEMART_Text_Supplies:
	.string "Supplies arrive rarely,\n"
	.string "so we waste nothing.\p"
	.string "Even a POTION is precious\n"
	.string "in the deep desert.$"
`
