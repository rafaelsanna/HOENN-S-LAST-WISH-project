mapscripts LittlerootCoast_MapScripts {}

script NidoranMOverworld {
	lock
	faceplayer
	playmoncry(SPECIES_NIDORAN_M, CRY_MODE_NORMAL)
	waitmoncry
	release
	end
}

script NidoranFOverworld {
	lock
	faceplayer
	playmoncry(SPECIES_NIDORAN_F, CRY_MODE_NORMAL)
	waitmoncry
	release
	end
}

script BirdKeeperLee {
  trainerbattle_single(TRAINER_LEE, LeeIntro, LeeLose)
	lock
	msgbox(LeeDialogue)
	release
	end
}

// format() wraps text to the box, using \n for line 2 and \l to wait/scroll.
// Adjacent quoted strings are joined; keep a space between sentences.
// Use \p to wait and start a fresh page. Poryscript adds the final $ for you.
text LeeDialogue {
	format("I'm trying to catch a WINGULL! "
	       "All my other birds get crushed by ROCK-types, "
	       "so I need one that can actually fight back!")
}

text LeeIntro {
	format("Birds are amazing, you know? "
	       "Some glide, some dive, some just scream. "
	       "But every one of them has style! "
	       "Think you can handle me?")
}

text LeeLose {
	format("That's why I need a WINGULL! "
	       "Terra, the Rustboro Gym Leader's ROCK-types "
	       "flatten every other bird I have!\p"
	       "But a WINGULL… THAT one might stand a chance!")
}

script ArtistPortinari {
	trainerbattle_single(TRAINER_PORTINARI, PortinariIntro, PortinariLose)
	lock
	msgbox(PortinariDialogue)
	release
	end
}

text PortinariDialogue {
	format("I came here to watch the waves. "
	       "This peaceful coast always inspires my art.")
}

text PortinariIntro {
	format("The rhythm of the sea… the waves... "
	       "All of it fuels my creativity!\p"
	       "Let me capture your style in battle!")
}

text PortinariLose {
	format("Defeated… yet inspired. "
	       "Your technique has given me a new idea "
	       "for my next painting!")
}
