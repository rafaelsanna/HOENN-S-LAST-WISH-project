raw `
Mtpyregrotto_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, Mtpyregrotto_OnTransition
	.byte 0

Mtpyregrotto_OnTransition:
	setflag FLAG_TEMP_5
	setflag FLAG_TEMP_6
	special HiddenGrotto_InitializeCurrent
	special HiddenGrotto_GetCurrentContentType
	call_if_eq VAR_RESULT, 2, Mtpyregrotto_EventScript_ShowPokemon
	call_if_eq VAR_RESULT, 3, Mtpyregrotto_EventScript_ShowVisibleItem
	end

Mtpyregrotto_EventScript_ShowPokemon::
	clearflag FLAG_TEMP_5
	return

Mtpyregrotto_EventScript_ShowVisibleItem::
	clearflag FLAG_TEMP_6
	return

Mtpyregrotto_EventScript_Pokemon::
	lock
	faceplayer
	special HiddenGrotto_CreateCurrentMon
	goto_if_eq VAR_RESULT, FALSE, Mtpyregrotto_EventScript_NoPokemon
	dowildbattle
	specialvar VAR_RESULT, GetBattleOutcome
	goto_if_eq VAR_RESULT, B_OUTCOME_WON, Mtpyregrotto_EventScript_ClearPokemon
	goto_if_eq VAR_RESULT, B_OUTCOME_RAN, Mtpyregrotto_EventScript_ClearPokemon
	goto_if_eq VAR_RESULT, B_OUTCOME_PLAYER_TELEPORTED, Mtpyregrotto_EventScript_ClearPokemon
	goto_if_eq VAR_RESULT, B_OUTCOME_CAUGHT, Mtpyregrotto_EventScript_ClearPokemon
	release
	end

Mtpyregrotto_EventScript_ClearPokemon::
	special HiddenGrotto_EmptyCurrent
	removeobject VAR_LAST_TALKED
	release
	end

Mtpyregrotto_EventScript_NoPokemon::
	release
	end

Mtpyregrotto_EventScript_VisibleItem::
	lock
	special HiddenGrotto_GetCurrentContentId
	giveitem VAR_RESULT
	goto_if_eq VAR_RESULT, FALSE, Common_EventScript_ShowBagIsFull
	special HiddenGrotto_EmptyCurrent
	removeobject VAR_LAST_TALKED
	release
	end

Mtpyregrotto_EventScript_HiddenItem::
	special HiddenGrotto_GetCurrentContentType
	goto_if_ne VAR_RESULT, 4, Mtpyregrotto_EventScript_NoHiddenItem
	lockall
	special HiddenGrotto_GetCurrentContentId
	giveitem VAR_RESULT
	goto_if_eq VAR_RESULT, FALSE, Mtpyregrotto_EventScript_HiddenBagFull
	special HiddenGrotto_EmptyCurrent
	releaseall
	end

Mtpyregrotto_EventScript_HiddenBagFull::
	msgbox gText_TooBadBagIsFull, MSGBOX_DEFAULT
	releaseall
	end

Mtpyregrotto_EventScript_NoHiddenItem::
	end
`
