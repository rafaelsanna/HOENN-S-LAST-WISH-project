raw `
LilycoveCity_House4_MapScripts::
	.byte 0

LilycoveCity_House4_EventScript_Man1::
	msgbox LilycoveCity_House4_Text_MysteriesAtBottomOfSea, MSGBOX_NPC
	end

LilycoveCity_House4_EventScript_Man2::
	msgbox LilycoveCity_House4_Text_UnderwaterTrenchMossdeepSootopolis, MSGBOX_NPC
	end

LilycoveCity_House4_Text_MysteriesAtBottomOfSea:
	.string "We've been married for years.\n"
	.string "LILYCOVE, the place to find love!\p"
	.string "The calm, the view, it's perfect.\n"
	.string "You don't seem focused on this, do you?\l"
	.string "Fair enough, focused solely on battles?\p"
	.string "With that spirit, you can go far!\p"
	.string "Like, becoming the Champion of HOENN!$"

LilycoveCity_House4_Text_UnderwaterTrenchMossdeepSootopolis:
	.string "Getting married is good…\n"
	.string "But focusing on what you like,\p"
	.string "It's the best thing you can ever do!$"

`
