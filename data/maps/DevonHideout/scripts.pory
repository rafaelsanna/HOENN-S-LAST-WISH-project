raw `
DevonHideout_MapScripts::
	.byte 0

@ Each clue has its own text below so it can be written independently.
DevonHideout_EventScript_FilingCabinet1::
	msgbox DevonHideout_Text_FilingCabinet1, MSGBOX_SIGN
	end

DevonHideout_EventScript_Stone1::
	msgbox DevonHideout_Text_Stone1, MSGBOX_SIGN
	end

DevonHideout_EventScript_Stone2::
	msgbox DevonHideout_Text_Stone2, MSGBOX_SIGN
	end

