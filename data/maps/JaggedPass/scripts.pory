mapscripts JaggedPass_MapScripts {
	MAP_SCRIPT_ON_RESUME: JaggedPass_OnResume
	MAP_SCRIPT_ON_TRANSITION: JaggedPass_OnTransition
	MAP_SCRIPT_ON_LOAD: JaggedPass_OnLoad
}

script JaggedPass_OnResume {
	setstepcallback(STEP_CB_ASH)
	if (var(VAR_JAGGED_PASS_STATE) == 0) {
		call(JaggedPass_EventScript_CheckHasMagmaEmblem)
	}
}

script JaggedPass_EventScript_CheckHasMagmaEmblem {
	checkitem(ITEM_MAGMA_EMBLEM)
	if (var(VAR_RESULT) == TRUE) {
		goto(JaggedPass_EventScript_SetReadyToOpenHideout)
	}
	return
}

script JaggedPass_EventScript_SetReadyToOpenHideout {
	setvar(VAR_JAGGED_PASS_STATE, 1)
	return
}

script JaggedPass_OnTransition {
	if (var(VAR_JAGGED_PASS_ASH_WEATHER) == 1) {
		call(JaggedPass_EventScript_SetWeatherAsh)
	}
}

script JaggedPass_EventScript_SetWeatherAsh {
	setweather(WEATHER_VOLCANIC_ASH)
	doweather
	return
}

script JaggedPass_OnLoad {
	if (var(VAR_JAGGED_PASS_STATE) <= 1) {
		goto(JaggedPass_EventScript_ConcealHideoutEntrance)
	}
}

script JaggedPass_EventScript_ConcealHideoutEntrance {
	setmetatile(16, 17, METATILE_Lavaridge_RockWall, TRUE)
	setmetatile(16, 18, METATILE_Lavaridge_RockWall, TRUE)
}

script JaggedPass_EventScript_OpenMagmaHideout {
	lockall
	setvar(VAR_0x8004, 1) // vertical pan
	setvar(VAR_0x8005, 1) // horizontal pan
	setvar(VAR_0x8006, 8) // num shakes
	setvar(VAR_0x8007, 5) // shake delay
	special(ShakeCamera)
	waitstate
	msgbox(JaggedPass_Text_BoulderShakingInResponseToEmblem)
	closemessage
	setvar(VAR_0x8004, 1) // vertical pan
	setvar(VAR_0x8005, 1) // horizontal pan
	setvar(VAR_0x8006, 16) // num shakes
	setvar(VAR_0x8007, 3) // shake delay
	special(ShakeCamera)
	waitstate
	playse(SE_EFFECTIVE)
	setmetatile(16, 17, METATILE_Lavaridge_CaveEntrance_Top, TRUE)
	setmetatile(16, 18, METATILE_Lavaridge_CaveEntrance_Bottom, FALSE)
	special(DrawWholeMapView)
	delay(30)
	setvar(VAR_JAGGED_PASS_STATE, 2)
	waitse
	releaseall
}

script JaggedPass_EventScript_MagmaHideoutGuard {
	lockall
	if (flag(FLAG_BEAT_MAGMA_GRUNT_JAGGED_PASS) == true) {
		goto(JaggedPass_EventScript_GuardDefeated)
	}
	waitse
	playse(SE_PIN)
	applymovement(LOCALID_MAGMA_HIDEOUT_GUARD, Common_Movement_ExclamationMark)
	waitmovement(0)
	applymovement(LOCALID_MAGMA_HIDEOUT_GUARD, Common_Movement_Delay48)
	waitmovement(0)
	applymovement(LOCALID_MAGMA_HIDEOUT_GUARD, Common_Movement_FacePlayer)
	waitmovement(0)
	msgbox(JaggedPass_Text_GruntIntro)
	closemessage
	trainerbattle_no_intro(TRAINER_GRUNT_JAGGED_PASS, JaggedPass_Text_GruntDefeat)
	setflag(FLAG_BEAT_MAGMA_GRUNT_JAGGED_PASS)
	applymovement(LOCALID_MAGMA_HIDEOUT_GUARD, Common_Movement_FaceOriginalDirection)
	waitmovement(0)
	releaseall
}

script JaggedPass_EventScript_GuardDefeated {
	applymovement(LOCALID_MAGMA_HIDEOUT_GUARD, Common_Movement_FacePlayer)
	waitmovement(0)
	msgbox(JaggedPass_Text_GoWhereverYouWant)
	closemessage
	applymovement(LOCALID_MAGMA_HIDEOUT_GUARD, Common_Movement_FaceOriginalDirection)
	waitmovement(0)
	releaseall
}

script JaggedPass_EventScript_Eric {
	trainerbattle_single(TRAINER_ERIC, JaggedPass_Text_EricIntro, JaggedPass_Text_EricDefeat)
	msgbox(JaggedPass_Text_EricPostBattle, MSGBOX_AUTOCLOSE)
}

script JaggedPass_EventScript_Diana {
	trainerbattle_single(TRAINER_DIANA_1, JaggedPass_Text_DianaIntro, JaggedPass_Text_DianaDefeat)
	specialvar(VAR_RESULT, ShouldTryRematchBattle)
	if (var(VAR_RESULT) == TRUE) {
		goto(JaggedPass_EventScript_DianaRematch)
	}
	msgbox(JaggedPass_Text_DianaPostBattle)
	release
}

script JaggedPass_EventScript_RegisterDiana {
	special(PlayerFaceTrainerAfterBattle)
	msgbox(JaggedPass_Text_DianaRegister)
	register_matchcall(TRAINER_DIANA_1)
	release
}

script JaggedPass_EventScript_DianaRematch {
	trainerbattle_rematch(TRAINER_DIANA_1, JaggedPass_Text_DianaRematchIntro, JaggedPass_Text_DianaRematchDefeat)
	msgbox(JaggedPass_Text_DianaPostRematch, MSGBOX_AUTOCLOSE)
}

script JaggedPass_EventScript_Ethan {
	trainerbattle_single(TRAINER_ETHAN_1, JaggedPass_Text_EthanIntro, JaggedPass_Text_EthanDefeat)
	specialvar(VAR_RESULT, ShouldTryRematchBattle)
	if (var(VAR_RESULT) == TRUE) {
		goto(JaggedPass_EventScript_EthanRematch)
	}
	msgbox(JaggedPass_Text_EthanPostBattle)
	release
}

script JaggedPass_EventScript_RegisterEthan {
	special(PlayerFaceTrainerAfterBattle)
	msgbox(JaggedPass_Text_EthanRegister)
	register_matchcall(TRAINER_ETHAN_1)
	release
}

script JaggedPass_EventScript_EthanRematch {
	trainerbattle_rematch(TRAINER_ETHAN_1, JaggedPass_Text_EthanRematchIntro, JaggedPass_Text_EthanRematchDefeat)
	msgbox(JaggedPass_Text_EthanPostRematch, MSGBOX_AUTOCLOSE)
}

script JaggedPass_EventScript_Julio {
	trainerbattle_single(TRAINER_JULIO, JaggedPass_Text_JulioIntro, JaggedPass_Text_JulioDefeat)
	msgbox(JaggedPass_Text_JulioPostBattle, MSGBOX_AUTOCLOSE)
}

script JaggedPass_EventScript_Autumn {
	trainerbattle_single(TRAINER_AUTUMN, JaggedPass_Text_AutumnIntro, JaggedPass_Text_AutumnDefeat)
	msgbox(JaggedPass_Text_AutumnPostBattle, MSGBOX_AUTOCLOSE)
}

// ===================================================================
// NPCs mineiros (fillers Blipbug) - ensinam/ativam a mineração
// ===================================================================
script JaggedPass_EventScript_MinerNPC {
	lock
	faceplayer
	if (flag(FLAG_LEARNED_MINING) == true) {
		msgbox(JaggedPass_Text_MinerNPC_AlreadyKnows)
		closemessage
		fadescreen(FADE_TO_BLACK)
		special(StartMining)
		release
	} else {
		msgbox(JaggedPass_Text_MinerNPC_Teach)
		closemessage
		setflag(FLAG_LEARNED_MINING)
		fadescreen(FADE_TO_BLACK)
		special(StartMining)
		release
	}
}

text JaggedPass_Text_EricIntro {
	"MT. CHIMNEY's JAGGED PASS…\p"
	"Now this is what I've always wanted\n"
	"in a mountain.\p"
	"This jagged bumpiness…\n"
	"It rocks my soul!"
}

text JaggedPass_Text_EricDefeat {
	"Losing left me bitter!"
}

text JaggedPass_Text_EricPostBattle {
	"Yes, I did lose at POKéMON…\p"
	"But, when it comes to the love of\n"
	"the mountains, I have you beat!"
}

text JaggedPass_Text_DianaIntro {
	"This place isn't your casual hike.\n"
	"It's not suited for a picnic."
}

text JaggedPass_Text_DianaDefeat {
	"Ohhh, no!\n"
	"The ground is too bumpy…"
}

text JaggedPass_Text_DianaPostBattle {
	"Did you know?\p"
	"Some people cleverly ride their\n"
	"bicycles up this horribly bumpy pass."
}

text JaggedPass_Text_DianaRegister {
	"Will you ever be back in this area?\n"
	"If you do return, I'd like a rematch."
}

text JaggedPass_Text_DianaRematchIntro {
	"Picnics are fun wherever you go.\n"
	"Just like POKéMON!"
}

text JaggedPass_Text_DianaRematchDefeat {
	"I only lost because the ground is\n"
	"too bumpy!"
}

text JaggedPass_Text_DianaPostRematch {
	"I'll forget about losing and just\n"
	"enjoy this bumpy hike."
}

text JaggedPass_Text_EthanIntro {
	"JAGGED PASS is hard to walk on.\n"
	"It's a good place for training."
}

text JaggedPass_Text_EthanDefeat {
	"It was all over while we were still\n"
	"trying to find a good footing…"
}

text JaggedPass_Text_EthanPostBattle {
	"If I had an ACRO BIKE, I'd be able to\n"
	"jump ledges."
}

text JaggedPass_Text_EthanRegister {
	"When I get more used to this bumpiness,\n"
	"I'll be sure to win!\p"
	"Can you register me in your POKéNAV?"
}

text JaggedPass_Text_EthanRematchIntro {
	"I got used to this bumpiness.\n"
	"I sing while I climb now."
}

text JaggedPass_Text_EthanRematchDefeat {
	"It's still not easy to battle on this\n"
	"bumpy ground…"
}

text JaggedPass_Text_EthanPostRematch {
	"I should get an ACRO BIKE from RYDEL\n"
	"in MAUVILLE CITY…"
}

text JaggedPass_Text_GruntIntro {
	"Wah!\n"
	"What are you doing here?\p"
	"What am I doing in a place like this?\p"
	"What business is it of yours?"
}

text JaggedPass_Text_GruntDefeat {
	"Urrrgh…\p"
	"I should've ducked into our HIDEOUT\n"
	"right away…"
}

text JaggedPass_Text_GoWhereverYouWant {
	"Okay, oh-kay!\n"
	"I admit it--you're strong!\p"
	"Don't worry about me.\n"
	"Go wherever you want!"
}

text JaggedPass_Text_BoulderShakingInResponseToEmblem {
	"Oh! This boulder is shaking in response\n"
	"to the MAGMA EMBLEM!"
}

text JaggedPass_Text_JulioIntro {
	"Aiyeeh! It's awfully scary to shoot\n"
	"down the mountain in one go!"
}

text JaggedPass_Text_JulioDefeat {
	"I feel like I'm falling apart…"
}

text JaggedPass_Text_JulioPostBattle {
	"My bicycle bounced around so much,\n"
	"my rear end's sore…"
}

text JaggedPass_Text_AutumnIntro {
	"I climb this hill every day.\n"
	"I have confidence in my strength!"
}

text JaggedPass_Text_AutumnDefeat {
	"Hmm…\n"
	"What went wrong?"
}

text JaggedPass_Text_AutumnPostBattle {
	"What is that odd rock protrusion\n"
	"a little up the hill from here?"
}

text JaggedPass_Text_MinerNPC_Teach {
	"Hm? You want to know how to dig\n"
	"for treasure in the rocks?\p"
	"It's easy! Just tap the rock where\n"
	"you think something's buried.\p"
	"Watch closely, I'll show you how\n"
	"it's done!"
}

text JaggedPass_Text_MinerNPC_AlreadyKnows {
	"Go on, give the rocks a try!\n"
	"You never know what you'll dig up."
}
