raw `
Route115Grotto_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, Route115Grotto_OnTransition
	.byte 0

Route115Grotto_OnTransition:
	setflag FLAG_TEMP_5
	setflag FLAG_TEMP_6
	special HiddenGrotto_InitializeCurrent
	special HiddenGrotto_GetCurrentContentType
	call_if_eq VAR_RESULT, 2, Route115Grotto_EventScript_ShowPokemon
	call_if_eq VAR_RESULT, 3, Route115Grotto_EventScript_ShowVisibleItem
	end

Route115Grotto_EventScript_ShowPokemon::
	clearflag FLAG_TEMP_5
	return

Route115Grotto_EventScript_ShowVisibleItem::
	clearflag FLAG_TEMP_6
	return

Route115Grotto_EventScript_Pokemon::
	lock
	faceplayer
	special HiddenGrotto_CreateCurrentMon
	goto_if_eq VAR_RESULT, FALSE, Route115Grotto_EventScript_NoPokemon
	dowildbattle
	specialvar VAR_RESULT, GetBattleOutcome
	goto_if_eq VAR_RESULT, B_OUTCOME_WON, Route115Grotto_EventScript_ClearPokemon
	goto_if_eq VAR_RESULT, B_OUTCOME_RAN, Route115Grotto_EventScript_ClearPokemon
	goto_if_eq VAR_RESULT, B_OUTCOME_PLAYER_TELEPORTED, Route115Grotto_EventScript_ClearPokemon
	goto_if_eq VAR_RESULT, B_OUTCOME_CAUGHT, Route115Grotto_EventScript_ClearPokemon
	release
	end

Route115Grotto_EventScript_ClearPokemon::
	special HiddenGrotto_EmptyCurrent
	removeobject VAR_LAST_TALKED
	release
	end

Route115Grotto_EventScript_NoPokemon::
	release
	end

Route115Grotto_EventScript_VisibleItem::
	lock
	special HiddenGrotto_GetCurrentContentId
	giveitem VAR_RESULT
	goto_if_eq VAR_RESULT, FALSE, Common_EventScript_ShowBagIsFull
	special HiddenGrotto_EmptyCurrent
	removeobject VAR_LAST_TALKED
	release
	end

Route115Grotto_EventScript_HiddenItem::
	special HiddenGrotto_GetCurrentContentType
	goto_if_ne VAR_RESULT, 4, Route115Grotto_EventScript_NoHiddenItem
	lockall
	special HiddenGrotto_GetCurrentContentId
	giveitem VAR_RESULT
	goto_if_eq VAR_RESULT, FALSE, Route115Grotto_EventScript_HiddenBagFull
	special HiddenGrotto_EmptyCurrent
	releaseall
	end

Route115Grotto_EventScript_HiddenBagFull::
	msgbox gText_TooBadBagIsFull, MSGBOX_DEFAULT
	releaseall
	end

Route115Grotto_EventScript_NoHiddenItem::
	end
`
